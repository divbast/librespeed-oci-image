includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    phpVersion: 80500
    paths:
        - rootfs/usr/local/bin/librespeed-bootstrap
        - rootfs/usr/local/bin/librespeed-health
        - rootfs/usr/local/share/librespeed-health/index.php
        - rootfs/usr/local/share/librespeed-login/login.php
        - test/in-container.php

    # Scanned for definitions, not analysed
    scanFiles:
        - stubs/librespeed-image.php
