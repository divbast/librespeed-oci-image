#!/usr/bin/env php
<?php
// SPDX-License-Identifier: BSD-2-Clause
// SPDX-FileCopyrightText: 2026 Aryan Ameri <github@aryan.ameri.coffee>

// There is no shell in this image, so nothing can chain "bootstrap && serve".
// This program does the bootstrap and then REPLACES ITSELF with the server via
// pcntl_exec so FrankenPHP inherits PID 1 and receives signals directly.

declare(strict_types=1);

const SERVER_BIN = '/usr/local/bin/frankenphp';
const CADDYFILE = '/etc/frankenphp/Caddyfile';
// Everything written per start, on the /tmp tmpfs. The image's own symlinks
// and the Caddyfile's imports point here.
const GENERATED_DIR = '/tmp/librespeed';
// Upstream's files the bootstrap renders from, kept out of the served tree
const TEMPLATES_DIR = '/usr/local/share/librespeed-templates';
// What outlives a start, and is needed only with telemetry on. The image's
// own results/idObfuscation_salt.php links to the salt here.
const DATA_DIR = '/data';
const TELEMETRY_DB = DATA_DIR . '/telemetry.db';
const SALT_FILE = DATA_DIR . '/idObfuscation_salt.php';

// index-modern.html's own text, found and replaced as upstream's entrypoint
// does. test/upstream-layout.sh fails the build on a release that drops one.
const TITLE_MARKER = '<title>LibreSpeed - Free and Open Source Speedtest</title>';
const HEADING_MARKER = '<h1>Free and Open Source Speedtest.</h1>';
const TAGLINE_MARKER = '<p class="tagline">No Flash, No Java, No Websockets, No Bullsh*t</p>';
const MAILTO_MARKER = 'mailto:PUT@YOUR_EMAIL.HERE';
const EMAIL_MARKER = 'TO BE FILLED BY DEVELOPER';

function fail(string $msg): never {
    fwrite(STDERR, "librespeed-bootstrap: $msg\n");
    exit(1);
}

function info(string $msg): void {
    fwrite(STDOUT, "librespeed-bootstrap: $msg\n");
}

/**
 * Unset or empty is the default. Anything but exactly true or false stops the
 * start: a typo must never quietly mean the default.
 */
function envBool(string $name, bool $default): bool {
    $value = getenv($name);
    if ($value === false || $value === '') {
        return $default;
    }

    return match ($value) {
        'true' => true,
        'false' => false,
        default => fail("$name must be true or false"),
    };
}

function envString(string $name): ?string {
    $value = getenv($name);

    return $value === false || $value === '' ? null : $value;
}

function escapeHtml(string $text): string {
    return htmlspecialchars($text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
}

/**
 * Upstream's modern page with the operator's title, tagline and contact
 * address in place of its own. Every marker must be there exactly once
 * whatever is set, so a changed template stops every start, not only the
 * ones that set a variable. strtr() makes one pass, so a value that happens
 * to contain another marker is never replaced in its turn.
 */
function renderIndex(string $template, ?string $title, ?string $tagline, ?string $email): string {
    foreach ([TITLE_MARKER, HEADING_MARKER, TAGLINE_MARKER, MAILTO_MARKER, EMAIL_MARKER] as $marker) {
        $count = substr_count($template, $marker);
        if ($count !== 1) {
            fail("index-modern.html holds $count copies of '$marker', where it should hold one");
        }
    }

    $replacements = [];
    if ($title !== null) {
        $replacements[TITLE_MARKER] = '<title>' . escapeHtml($title) . ' - Free and Open Source Speedtest</title>';
        $replacements[HEADING_MARKER] = '<h1>' . escapeHtml($title) . '</h1>';
    }
    if ($tagline !== null) {
        $replacements[TAGLINE_MARKER] = '<p class="tagline">' . escapeHtml($tagline) . '</p>';
    }
    if ($email !== null) {
        $replacements[MAILTO_MARKER] = 'mailto:' . escapeHtml($email);
        $replacements[EMAIL_MARKER] = escapeHtml($email);
    }

    return strtr($template, $replacements);
}

/**
 * Written beside its final name, then renamed over it, so the server never
 * reads half a file.
 */
function writeGenerated(string $name, string $content): void {
    $path = GENERATED_DIR . "/$name";
    $staging = "$path.new";
    if (@file_put_contents($staging, $content) === false
        || !@chmod($staging, 0o644)
        || !@rename($staging, $path)) {
        @unlink($staging);
        fail("cannot write $path");
    }
}

function readTemplate(string $name): string {
    $path = TEMPLATES_DIR . "/$name";
    $content = @file_get_contents($path);
    if ($content === false) {
        fail("cannot read $path: this is not a complete LibreSpeed image");
    }

    return $content;
}

/**
 * @param array<mixed>|stdClass $value
 */
function toJson(array|stdClass $value): string {
    return json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
}

/**
 * /data must take a new file, as SQLite does for its journal on every
 * write. The image's own /data is on the read-only root, so a start without
 * a volume stops here, as does one on a volume this uid cannot write.
 * Upstream's scripts would otherwise answer every result with an empty 200,
 * and record nothing.
 */
function requireWritableData(): void {
    $needs = 'TELEMETRY=true needs a writable ' . DATA_DIR . ' volume (uid ' . getmyuid() . ')';
    if (!is_dir(DATA_DIR)) {
        fail("$needs, and there is no " . DATA_DIR . ' directory');
    }

    $probe = DATA_DIR . '/.librespeed-bootstrap-probe';
    error_clear_last();
    if (@file_put_contents($probe, '') === false || !@unlink($probe)) {
        fail("$needs: " . (error_get_last()['message'] ?? "cannot create and remove $probe"));
    }
}

/**
 * A file the server will need, if it is there already, as after a restore
 * from a backup. SQLite opens a database it cannot write read-only, without
 * a word, and upstream reads a salt it cannot read as 0, which changes every
 * id it hands out.
 */
function requireUsable(string $path, bool $write): void {
    clearstatcache(true, $path);
    if (!file_exists($path) && !is_link($path)) {
        return;
    }
    if (!is_file($path) || !is_readable($path) || ($write && !is_writable($path))) {
        fail("$path is there, but uid " . getmyuid() . ' cannot ' . ($write ? 'read and write' : 'read') . ' it');
    }
}

/**
 * The settings upstream's results scripts require. Each value is
 * var_export()ed; the names are upstream's.
 */
function telemetrySettings(bool $obfuscateIds, bool $redactIps): string {
    $settings = [
        'db_type' => 'sqlite',
        // Upstream's stats.php compares a login with this. Random and new on
        // every start, so no default password ever opens it.
        'stats_password' => bin2hex(random_bytes(32)),
        'enable_id_obfuscation' => $obfuscateIds,
        'redact_ip_addresses' => $redactIps,
        'Sqlite_db_file' => TELEMETRY_DB,
    ];

    $php = "<?php\n// Written by librespeed-bootstrap on every start\n";
    foreach ($settings as $name => $value) {
        $php .= '$' . $name . ' = ' . var_export($value, true) . ";\n";
    }

    return $php;
}

/**
 * The salt that obfuscates result ids, made once and then left alone: every
 * share link handed out was made with it. It is in upstream's own format,
 * the one idObfuscation.php writes itself when it finds none; the value is
 * bin2hex() output, so there is nothing in it to escape.
 */
function ensureSalt(): void {
    clearstatcache(true, SALT_FILE);
    if (file_exists(SALT_FILE)) {
        return;
    }

    $staging = SALT_FILE . '.new';
    if (!@touch($staging)
        || !@chmod($staging, 0o600)
        || @file_put_contents($staging, "<?php\n\n\$OBFUSCATION_SALT = 0x" . bin2hex(random_bytes(4)) . ";\n") === false
        || !@rename($staging, SALT_FILE)) {
        @unlink($staging);
        fail('cannot create ' . SALT_FILE);
    }
    info('created ' . SALT_FILE . '; it belongs with ' . TELEMETRY_DB . ' in every backup');
}

/**
 * The :8080 routes only some settings turn on. Caddy sorts a bare
 * directive after the Caddyfile's handle blocks, where the catch-all has
 * already answered 404, so every route here is a handle block of its own.
 */
function writeSiteSnippet(bool $telemetry, bool $stats): void {
    if ($stats) {
        fail('this image has no stats routes yet');
    }
    if (!$telemetry) {
        writeGenerated('caddy/site.caddy', "# librespeed-bootstrap: telemetry is off, so no optional routes\n");

        return;
    }

    writeGenerated('caddy/site.caddy', <<<'CADDY'
        # librespeed-bootstrap: telemetry is on
        # Records a result, and shows one as JSON and as the share image
        @telemetry path /results/telemetry.php /results/json.php /results/index.php
        handle @telemetry {
        	php
        }
        # The share image as the modern UI links it, /results/?id=…
        handle /results/ {
        	rewrite * /results/index.php
        	php
        }

        CADDY);
}

// Every variable is read and checked before anything is written
$telemetry = envBool('TELEMETRY', false);
$redactIps = envBool('REDACT_IP_ADDRESSES', false);
$obfuscateIds = envBool('ENABLE_ID_OBFUSCATION', false);
$title = envString('TITLE');
$tagline = envString('TAGLINE');
$email = envString('GDPR_EMAIL');

if ($telemetry) {
    requireWritableData();
    requireUsable(TELEMETRY_DB, true);
    if ($obfuscateIds) {
        requireUsable(SALT_FILE, false);
    }
} else {
    $ignored = array_keys(array_filter(
        [
            'REDACT_IP_ADDRESSES' => envString('REDACT_IP_ADDRESSES'),
            'ENABLE_ID_OBFUSCATION' => envString('ENABLE_ID_OBFUSCATION'),
        ],
        static fn (?string $value): bool => $value !== null,
    ));
    if ($ignored !== []) {
        info('TELEMETRY is off, so these are ignored: ' . implode(', ', $ignored));
    }
}

foreach ([GENERATED_DIR, GENERATED_DIR . '/caddy'] as $dir) {
    if (!is_dir($dir) && !@mkdir($dir, 0o700)) {
        fail("cannot create $dir - is /tmp a tmpfs writable by uid " . getmyuid() . '?');
    }
    // mkdir() honours the umask, and a directory left by an earlier start
    // keeps whatever mode it had.
    if (!@chmod($dir, 0o700)) {
        fail("cannot make $dir private to uid " . getmyuid());
    }
}

// Upstream's settings, kept as objects where they are objects, with the
// telemetry level this start allows. Only basic, which records the results
// alone. full and debug also send the worker's log: at debug it outgrows
// what post_max_size lets PHP read, and upstream then records a row of
// nulls.
try {
    $settings = json_decode(readTemplate('settings.json'), false, 512, JSON_THROW_ON_ERROR);
} catch (JsonException $e) {
    fail('upstream settings.json is not JSON: ' . $e->getMessage());
}
if (!$settings instanceof stdClass) {
    fail('upstream settings.json is not a JSON object');
}
$settings->telemetry_level = $telemetry ? 'basic' : 'off';
// The worker sends this with every record, wrapped with the server's name.
// Left to the worker, it is that name alone.
unset($settings->telemetry_extra);

// The local backend alone, in the shape upstream's entrypoint writes for
// standalone mode. A relative server keeps every test on the origin the
// page came from.
$servers = [[
    'name' => 'local',
    'server' => '/backend',
    'dlURL' => 'garbage.php',
    'ulURL' => 'empty.php',
    'pingURL' => 'empty.php',
    'getIpURL' => 'getIP.php',
    'sponsorName' => '',
    'sponsorURL' => '',
    'id' => 1,
]];

writeGenerated('index.html', renderIndex(readTemplate('index-modern.html'), $title, $tagline, $email));
writeGenerated('settings.json', toJson($settings));
writeGenerated('server-list.json', toJson($servers));
// What this start turned on, for the health check
writeGenerated('state.json', toJson(['telemetry' => $telemetry]));
if ($telemetry) {
    writeGenerated('telemetry_settings.php', telemetrySettings($obfuscateIds, $redactIps));
    if ($obfuscateIds) {
        ensureSalt();
    }
    info('telemetry is on: results are recorded in ' . TELEMETRY_DB);
} elseif (file_exists(GENERATED_DIR . '/telemetry_settings.php')
    && !@unlink(GENERATED_DIR . '/telemetry_settings.php')) {
    fail('cannot remove ' . GENERATED_DIR . '/telemetry_settings.php');
}
// The Caddyfile imports both snippets unconditionally, so each must exist
// even when it has nothing to say.
writeGenerated('caddy/global.caddy', "# librespeed-bootstrap: no global options\n");
writeSiteSnippet($telemetry, false);

info('ready');

// Replace this process with the server
pcntl_exec(SERVER_BIN, ['run', '--config', CADDYFILE]);
fail('pcntl_exec failed to start ' . SERVER_BIN);
