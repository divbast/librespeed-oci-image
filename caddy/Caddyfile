{
	# container speaks plain HTTP over a trusted network.
	auto_https off
	# No admin API. Caddy would otherwise listen on 127.0.0.1:2019, outside
	# the contract's two ports, and take a new config from anything that
	# shares the container's network, with no credentials. Nothing here
	# reloads, and FrankenPHP's admin routes only restart workers, which
	# this server does not run.
	admin off
	frankenphp
	log {
		output stdout
		format json
		exclude http.handlers.php
	}
	# PHP's error log, which FrankenPHP writes as the php handler. php.ini
	# lets only real errors through.
	log php {
		output stderr
		format json
		include http.handlers.php
	}
	# Written by the bootstrap on every start, from env
	import /tmp/librespeed/caddy/global.caddy
}

# An allowlist: what is not named here, or in site.caddy, is a 404. That keeps
# upstream's helpers, its data files and its other pages unreachable although
# they sit in the same tree.
:8080 {
	root /var/www/librespeed

	# The speed test's three endpoints, the only PHP served unconditionally
	@speedtest path /backend/empty.php /backend/garbage.php /backend/getIP.php
	handle @speedtest {
		php
	}

	@static {
		# The modern UI the bootstrap renders, and its generated config
		path / /settings.json /server-list.json /servers.json
		# The speed test's client and the stability test
		path /speedtest.js /speedtest_worker.js /stability.html /stability_worker.js
		# What both pages load
		path /favicon.ico /manifest.webmanifest /images/* /frontend/*
	}
	handle @static {
		file_server
	}

	# Written by the bootstrap on every start: the routes only some
	# settings turn on. Each must be a handle block. Caddy sorts a bare
	# directive, such as respond, after every handle here, and by then the
	# catch-all below has answered 404. Handle blocks whose paths are as
	# long as each other keep the order they are written in, and the first
	# that matches answers. So site.caddy writes the stats login's blocks,
	# which match stats.php's own path, before stats.php's block, or
	# upstream's form would never reach the login.
	import /tmp/librespeed/caddy/site.caddy

	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}

# Internal health listener, meant to stay unpublished: /healthz, and a 404
# for everything else. Its root is outside the served tree, and the rewrite
# names the one script it runs. It deliberately carries no log block:
# HEALTHCHECK asks for /healthz every 30 s, and those thousands of access-log
# lines a day would bury :8080's, which are the ones worth reading.
:8081 {
	root /usr/local/share/librespeed-health
	handle /healthz {
		rewrite * /index.php
		php
	}
	handle {
		respond 404
	}
}
